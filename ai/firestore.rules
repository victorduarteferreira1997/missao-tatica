rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return database == 'missao-tatica-ai' && request.auth != null
        && request.auth.uid == '1LDBfIQ5vQTUtaE5j0k4Sp9w7Rj2' && uid == request.auth.uid;
    }
    match /users/{uid}/context/{week} {
      allow get: if owner(uid);
      allow create, update: if owner(uid)
        && week.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasAll(['payload'])
        && request.resource.data.keys().hasOnly(['payload'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 64000;
      allow delete: if owner(uid);
    }
    match /users/{uid}/inbox/{proposal} {
      allow get, list: if owner(uid);
      // The API creates proposals via IAM. Browser clients can only review them.
      allow update: if owner(uid) && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted','rejected']
        && request.resource.data.reviewedAt is timestamp
        && request.resource.data.reviewedAt <= request.time + duration.value(1,'m')
        && request.resource.data.reviewedAt >= request.time - duration.value(5,'m')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt']);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
